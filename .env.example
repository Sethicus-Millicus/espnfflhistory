# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- Supabase (from Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key       # public read key (used by the web app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # write key (used by loader scripts only)

# --- Sleeper (public API, no auth needed) ---
SLEEPER_LEAGUE_ID=1389723831165259776

# --- ESPN (private league cookies; from your browser session) ---
ESPN_LEAGUE_ID=564698
ESPN_SWID={823B7B7A-5AFC-4B2E-A22A-B2D690D236A8}
ESPN_S2=paste-your-espn_s2-cookie-here
